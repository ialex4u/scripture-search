# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public and safe to ship in the built app. Never put the
# service_role key here.
#
# With these unset the app still builds and runs: reading, searching and
# on-device bookmarks work exactly as before, and the Account tab explains
# that accounts are not set up yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
