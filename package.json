{
  "name": "scripture-search",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A free, offline-first PWA for reading and searching the scriptures of the world.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:registry": "node pipeline/build-registry.mjs",
    "data:quran": "node pipeline/fetch-quran.mjs",
    "data:hadith": "node pipeline/fetch-hadith.mjs",
    "data:bible": "node pipeline/fetch-bible.mjs",
    "data:tanakh": "node pipeline/fetch-tanakh.mjs",
    "data:gita": "node pipeline/fetch-gita.mjs",
    "data:dhammapada": "node pipeline/fetch-dhammapada.mjs",
    "data:guru-granth-sahib": "node pipeline/fetch-guru-granth.mjs",
    "data:tao-te-ching": "node pipeline/fetch-tao.mjs",
    "data:analects": "node pipeline/fetch-analects.mjs",
    "data:upanishads": "node pipeline/fetch-upanishads.mjs",
    "data:rigveda": "node pipeline/fetch-rigveda.mjs",
    "data:yogasutras": "node pipeline/fetch-yogasutras.mjs",
    "data:indexes": "node pipeline/build-indexes.mjs",
    "data:all": "node pipeline/build-all.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.1.0",
    "@fontsource/noto-sans-devanagari": "^5.1.0",
    "@fontsource/noto-sans-gurmukhi": "^5.1.0",
    "@fontsource/noto-sans-hebrew": "^5.1.0",
    "@fontsource/noto-sans-jp": "^5.1.0",
    "@fontsource/noto-sans-sc": "^5.1.0",
    "minisearch": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "transliteration": "^2.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
